{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": { "analytics": false },
  "schematics": {
    "@schematics/angular:component": { "standalone": true, "skipTests": true, "style": "css" },
    "@schematics/angular:service": { "skipTests": true },
    "@schematics/angular:pipe": { "skipTests": true },
    "@schematics/angular:directive": { "skipTests": true }
  },
  "projects": {
    "wallet-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/wallet-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "650kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "development": { "buildTarget": "wallet-ui:build:development" },
            "production": { "buildTarget": "wallet-ui:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
